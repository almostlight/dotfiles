# Default config for swa$x_scale
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.
set $wl_scale 1.25
# Scale for workspace 10
set $x_scale 1.0

output eDP-1 scale $wl_scale adaptive_sync on
output <name> scale_filter linear

set $conf "~/.config/sway"
exec export PATH="/var/lib/flatpak/exports/bin:$PATH"
exec export QT_QPA_PLATFORMTHEME="qt6ct"
exec --no-startup-id keepassxc --minimized

# set tiling settings 
for_window [app_id="blueman-manager"] floating enable
 # Spiral layout
for_window [tiling] splitt
default_orientation vertical 

xwayland enable
#exec --no-startup-id Xwayland -dpi 210

# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Colors
set $bg				#949494
set $bg-inactive	#323232
set $bg-urgent		#000000
set $text			#eeeeec
set $text-inactive	#babdb6

set $bar			#323232
set $statusline		#e0e0e0
set $accent			#FF8700

# hide mouse after 5 secs
# seat seat0 hide_cursor 5000
exec_always --no-startup-id ~/.config/sway/scripts/battery-notify.sh
exec_always --no-startup-id nm-applet
exec_always --no-startup-id blueman-applet
exec_always --no-startup-id dunst ~/.config/dunst/dunstrc & notify-send "Dunst started"
exec_always --no-startup-id notify-send $(asusctl profile -p | grep -i "active")
exec_always --no-startup-id wl-paste -n --watch clipman store --no-persist
# Primary clipboard is modified by text selections.
# wl-paste -p -n -t text --watch clipman store --histpath="~/.local/share/clipman-primary.json"
exec_always --no-startup-id  clipman restore

client.focused          $bg           $bg          $text          $bg $bg
client.unfocused        $bg-inactive  $bg-inactive $text-inactive $bar $bar
client.focused_inactive $bg-inactive  $bg-inactive $text-inactive $bar $bar
client.urgent           $bg-urgent    $bg-urgent   $text          $bar $bar
### Variables
#
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term alacritty
# set $explorer thunar
set $explorer exec dolphin
set $email thunderbird

set $browser firefox
# Your preferred application launcher
set $menu wofi --show drun

# set $screenshot grim ~/Pictures/Screenshots/scrn-$(date +"%Y-%m-%d-%H-%M-%S").png
set $screenshot sh -c 'grim - | tee ~/Pictures/Screenshots/scrn-$(date +"%Y-%m-%d-%H-%M-%S").png | wl-copy'
# set $screenclip slurp | grim -g - ~/Pictures/Screenshots/scrn-$(date +"%Y-%m-%d-%H-%M-%S").png
set $screenclip sh -c 'slurp | grim -g - - | tee ~/Pictures/Screenshots/scrn-$(date +"%Y-%m-%d-%H-%M-%S").png | wl-copy'

set $background ~/.config/sway/wallpaper

# Float windows by default
for_window [app_id="pavucontrol"] floating enable


for_window [title="^.*"] title_format ""
default_border pixel 1
default_floating_border pixel 2

### Output configuration
#
# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
# output * bg /usr/share/backgrounds/sway/Sway_Wallpaper_Blue_1920x1080.png fill
output * bg $background fill
### Idle configuration
#
# Example configuration:
#
exec swayidle -w \
         timeout 60 'swaylock -f --grace 30' \
         timeout 90 'swaymsg "output * power off"' \
		 resume 'swaymsg "output * power on"' \
         before-sleep 'swaylock -f -c 000000'
#
# This will lock your screen after 60 seconds of inactivity, then turn off
# your displays after another 60 seconds, and turn your screens back on when
# resumed. It will also lock your screen before your computer goes to sleep.

### Input configuration
#
# Example configuration:
#
input type:touchpad {
    dwt enabled
    tap enabled
	click_method clickfinger
    natural_scroll enabled
    middle_emulation enabled
}

input type:keyboard {
	xkb_layout "pl"
	xkb_variant ""
	xkb_options "compose:ralt"
}

input * {
    xkb_options caps:escape_shifted_capslock
}

# You can also configure each device individually.
# Read `man 5 sway-input` for more information about this section.

### Key bindings
#
# Basics:
#
# Start a terminal
bindsym $mod+Return exec $term

bindsym $mod+v exec clipman pick --tool wofi

# Kill focused window
bindsym $mod+Shift+q kill

# Launcher 
bindsym $mod+d exec $menu 
bindsym $mod+Shift+d exec $browser
# bindsym $mod+Shift+v exec nwg-clipman
bindsym $mod+e exec $explorer
bindsym $mod+m exec $email
bindsym $mod+Escape exec swaylock -f -c 000000

# Drag floating windows by holding down $mod and left mouse button.
# Resize them with right mouse button + $mod.
# Despite the name, also works for non-floating windows.
# Change normal to inverse to use left mouse button for resizing and right
# mouse button for dragging.
floating_modifier $mod normal

#
# Moving around:
#
# Move your focus around
bindsym $mod+$left focus left

bindsym $mod+$up focus up
bindsym $mod+$right focus right
# Or use $mod+[up|down|left|right]
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move the focused window with the same, but add Shift
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
# Ditto, with arrow keys
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
#
#
# Layout stuff:
#
# You can "split" the current object of your focus with
# $mod+b or $mod+v, for horizontal and vertical splits
# respectively.
bindsym $mod+Shift+b splith
bindsym $mod+Shift+v splitv

# Switch the current container between different layout styles
# bindsym $mod+s layout stacking
# bindsym $mod+w layout tabbed
bindsym $mod+x layout toggle split

# Make the current focus fullscreen
bindsym $mod+f fullscreen

# Toggle the current focus between tiling and floating mode
bindsym $mod+Shift+space floating toggle

# Swap focus between the tiling area and the floating area
bindsym $mod+space focus mode_toggle

# Move focus to the parent container
bindsym $mod+a focus parent
#
# Scratchpad:
#
# Sway has a "scratchpad", which is a bag of holding for windows.
# You can send windows there and get them back later.

# Move the currently focused window to the scratchpad
bindsym $mod+Shift+minus move scratchpad

# Show the next scratchpad window or hide the focused scratchpad window.
# If there are multiple scratchpad windows, this command cycles through them.
bindsym $mod+minus scratchpad show
#
# Resizing containers:
#
mode "Resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Ditto, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "Resize"
#
# Utilities:
#
# Special keys to adjust volume via PulseAudio
bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle
# Special keys to adjust brightness via brightnessctl
bindsym --locked XF86MonBrightnessDown exec "$conf/scripts/backlight.sh 5%-"
bindsym --locked XF86MonBrightnessUp exec "$conf/scripts/backlight.sh 5%+""
# Full screen screenshot
bindsym $mod+Print exec $screenshot
# Area selection screenshot
bindsym Print exec $screenclip
# Player controls
bindsym Control+Alt+Down exec playerctl play-pause
bindsym Control+Alt+Right exec playerctl next
bindsym Control+Alt+Left exec playerctl previous

bindsym --locked XF86Launch1 exec rog-control-center
# bindsym --locked XF86Launch3 exec 
bindsym --locked XF86Launch4 exec $conf/scripts/power_profile.sh
# bindsym --locked F86KbdBrightnessUp exec 
# bindsym --locked F86KbdBrightnessDown exec 

## Exiting Sway
# F2: Reload or restart inplace
bindsym $mod+F2 reload
bindsym $mod+Shift+F2 restart

bindsym XF86Sleep exec systemctl suspend
bindsym Shift+XF86Sleep exec systemctl hybrid-sleep

set $mode_system <small><b>L</b>ock, <b>E</b>xit, S<b>u</b>spend, <b>H</b>ibernate, <b>R</b>eboot, <b>S</b>hutdown</small>
bindsym XF86PowerOff mode "$mode_system"
bindsym $mod+F4 mode "$mode_system"
bindsym $mod+Shift+e mode "$mode_system"
mode --pango_markup "$mode_system" {
    bindsym l exec swaylock -f -c 000000, mode "default"
    bindsym u exec systemctl suspend, mode "default"
    bindsym e exit
    bindsym h exec systemctl hibernate, mode "default"
    bindsym r exec systemctl reboot, mode "default"
    bindsym s exec systemctl poweroff, mode "default"
    # exit system mode: "Enter" or "Escape"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# Workspaces:
#
set $ws1 1:
set $ws2 2:
set $ws3 3:
set $ws8 8:
set $ws9 9:
set $ws10 10:
# Switch to workspace
bindsym $mod+1 workspace $ws1; exec swaymsg "output * scale $wl_scale"
bindsym $mod+2 workspace $ws2; exec swaymsg "output * scale $wl_scale"
bindsym $mod+3 workspace $ws3; exec swaymsg "output * scale $wl_scale"
bindsym $mod+4 workspace $ws4; exec swaymsg "output * scale $wl_scale"
bindsym $mod+5 workspace $ws5; exec swaymsg "output * scale $wl_scale"
bindsym $mod+6 workspace $ws6; exec swaymsg "output * scale $x_scale"
bindsym $mod+7 workspace $ws7; exec swaymsg "output * scale $x_scale"
bindsym $mod+8 workspace $ws8; exec swaymsg "output * scale $x_scale"
bindsym $mod+9 workspace $ws9; exec swaymsg "output * scale $x_scale"
bindsym $mod+0 workspace $ws10; exec swaymsg "output * scale $x_scale"
# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

for_window [app_id="keepassxc"] floating enable

bar {
	swaybar_command waybar
	position       top
}

include /etc/sway/config.d/*
include ~/.config/sway/$(hostname)/*

